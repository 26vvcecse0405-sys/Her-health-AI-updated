# Optional. The demo works with none of these set.
# Restart `npm run dev` after changing this file.
# Never prefix these with VITE_. They are read only by the dev server.

# Online model. Leave blank to stay on curated answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Ollama. Example compact model: ollama pull qwen2.5:0.5b
# The app does not call this until the URL is set.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:0.5b

# Or any local OpenAI-compatible server, such as a small quantized model on :8080.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# Real maps, traffic, and hospital capacity are not wired in.
# A future adapter can replace src/data/hospitals.ts and the rank inputs
# without changing the scoring explanation.
# MAP_PROVIDER_URL=
# HOSPITAL_DIRECTORY_URL=
