# Optional. The app runs in demo mode without any of these.
# Restart `npm run dev` after changing this file.

# Read only by the Vite server plugin. Never prefix this with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public client settings. The anon key is meant for the browser; row policies
# in supabase/schema.sql restrict each student to their own profile.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
